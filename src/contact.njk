---
layout: layouts/base.njk
title: "Contact"
permalink: /contact/
eleventyExcludeFromCollections: true
---

<h1 id="contact"><a href="#contact">Contact</a></h1>
<p class="page-lead">Spotted a mistake in a note, working on a similar PLC, Linux, or retro hardware project, or just want to say hello? Reach out directly below.</p>

<div class="contact-grid">
  <div class="contact-card">
    <div class="contact-card-head">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
      </svg>
      <span>Email</span>
    </div>
    <a href="mailto:{{ site.email }}" class="contact-card-val">{{ site.email }}</a>
    <p class="contact-card-note">Best way to reach me for technical questions, corrections, or feedback.</p>
    <div class="contact-card-actions">
      <a href="mailto:{{ site.email }}" class="btn">Send email</a>
      <button type="button" id="copy-email-btn" class="btn btn-secondary">Copy address</button>
    </div>
  </div>

  <div class="contact-card">
    <div class="contact-card-head">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
        <path d="M9 18c-4.51 2-5-2-7-2"></path>
      </svg>
      <span>GitHub</span>
    </div>
    <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer" class="contact-card-val">{{ site.githubLabel }}</a>
    <p class="contact-card-note">Scripts, automation snippets, retro mods, and open-source experiments.</p>
    <div class="contact-card-actions">
      <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Open profile &rarr;</a>
    </div>
  </div>
</div>

<div class="contact-panel">
  <h2>Quick message</h2>
  <p class="contact-panel-note">No tracking or backend forms — this simply opens a pre-filled draft in your email client (or lets you copy it).</p>
  <form id="contact-form" onsubmit="return false;">
    <div class="contact-field-grid">
      <label class="contact-label">
        Subject
        <input type="text" id="msg-subject" class="archive-filter" placeholder="e.g. Question about KUKA drive cloning">
      </label>
    </div>
    <label class="contact-label" style="margin-top: 0.75rem;">
      Message
      <textarea id="msg-body" class="archive-filter contact-textarea" rows="5" placeholder="Write your message here..."></textarea>
    </label>
    <div class="contact-card-actions" style="margin-top: 0.9rem;">
      <button type="button" id="open-mail-btn" class="btn">Open in email client</button>
      <button type="button" id="copy-msg-btn" class="btn btn-secondary">Copy message</button>
    </div>
  </form>
</div>

<script>
(function() {
  const email = '{{ site.email }}';
  function copyText(text, btn, origLabel) {
    const done = () => {
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = origLabel; }, 2000);
    };
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(done);
    } else {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); done(); } catch (e) {}
      ta.remove();
    }
  }

  const copyEmailBtn = document.getElementById('copy-email-btn');
  copyEmailBtn.addEventListener('click', () => copyText(email, copyEmailBtn, 'Copy address'));

  document.getElementById('open-mail-btn').addEventListener('click', () => {
    const subj = document.getElementById('msg-subject').value.trim() || 'Message via {{ site.domain }}';
    const body = document.getElementById('msg-body').value.trim();
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subj)}&body=${encodeURIComponent(body)}`;
  });

  const copyMsgBtn = document.getElementById('copy-msg-btn');
  copyMsgBtn.addEventListener('click', () => {
    const subj = document.getElementById('msg-subject').value.trim() || 'Message via {{ site.domain }}';
    const body = document.getElementById('msg-body').value.trim();
    copyText(`To: ${email}\nSubject: ${subj}\n\n${body}`, copyMsgBtn, 'Copy message');
  });
})();
</script>
