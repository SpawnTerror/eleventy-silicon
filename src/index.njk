---
layout: layouts/base.njk
title: "Home"
eleventyExcludeFromCollections: true
---

<h1 id="most-read" class="section-heading"><a href="#most-read">Most Read</a></h1>

<ul class="post-list">
{% for url in featured %}
  {% for post in collections.posts %}
    {% if post.url == url %}
    <li class="post-row">
      <div class="post-row-main">
        <a href="{{ post.url }}" class="post-row-title">{{ post.data.title }}</a>
      </div>
      <div class="post-row-meta">
        <span class="post-date">{{ post.date | isoDate }}</span>
        <div class="post-row-tags">
          {% for tag in post.data.tags %}
            {% if tag != "posts" %}
              <a href="/tags/{{ tag | lower }}/" class="post-tag">{{ tag }}</a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </li>
    {% endif %}
  {% endfor %}
{% endfor %}
</ul>

<h2 id="latest-updates" class="section-heading" style="margin-top: 2.25rem;"><a href="#latest-updates">Latest Updates</a></h2>

<ul class="post-list">
{% for post in collections.posts | limit(5) %}
    <li class="post-row">
      <div class="post-row-main">
        <a href="{{ post.url }}" class="post-row-title">{{ post.data.title }}</a>
        {% if post.data.draft %}<span class="draft-badge">DRAFT</span>{% endif %}
      </div>
      <div class="post-row-meta">
        <span class="post-date">{{ post.date | isoDate }}</span>
        <div class="post-row-tags">
          {% for tag in post.data.tags %}
            {% if tag != "posts" %}
              <a href="/tags/{{ tag | lower }}/" class="post-tag">{{ tag }}</a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </li>
{% endfor %}
</ul>

<div class="archive-cta-wrap">
  <a href="/archive/" class="archive-cta">
    <span>Browse all {{ collections.posts | length }} notes</span>
    <span class="archive-cta-arrow" aria-hidden="true">&rarr;</span>
  </a>
</div>
