<div class="topic-list">
{% for topic in topics %}
  {% set topicPosts = collections[topic.slug] or collections[topic.title] or collections[topic.title | lower] %}
  {% set count = topicPosts | length if topicPosts else 0 %}
  <div class="topic-item">
    <div class="topic-header">
      <a href="/tags/{{ topic.slug }}/" class="topic-title">{{ topic.title }}</a>
      <span class="topic-count">{{ count }} {{ "article" if count == 1 else "articles" }}</span>
    </div>
    <p class="topic-description">{{ topic.description }}</p>
  </div>
{% endfor %}
</div>
